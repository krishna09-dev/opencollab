{
  "compilerOptions": {
    // Node + Express backend target
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    // Folder structure
    "rootDir": "src",
    "outDir": "dist",

    // Node environment
    "types": ["node"],
    "esModuleInterop": true,

    // Type checking
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}